# ---- Runtime ---------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# ---- LLM (OpenAI-compatible /chat/completions). Leave empty to use deterministic fallbacks.
# OpenRouter FREE models only. Free model availability changes; list current ones at
# https://openrouter.ai/models?max_price=0  (ids end in ":free").
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                       # OpenRouter key (sk-or-v1-...)
LLM_MODEL=dots-studio/dots-3-note-preview:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free   # max 2 (OpenRouter caps at 3 total)
LLM_FREE_ONLY=true                 # refuses any non-":free" model and caps every OpenRouter request at $0
LLM_TIMEOUT_SECONDS=30             # keep below the frontend's 45s wait
LLM_MAX_RETRIES=1
LLM_RESPONSE_FORMAT=json_object    # json_schema | json_object (most free models lack strict schemas)

# ---- Auth ------------------------------------------------------------------
# local    = backend issues signed anonymous sessions (POST /api/v1/auth/anonymous)
# supabase = clients send Supabase Auth access tokens; RLS applies to every query
AUTH_MODE=local
LOCAL_JWT_SECRET=                  # >= 32 random chars; required when ENVIRONMENT=production and AUTH_MODE=local

# ---- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: server-side ONLY (corpus retrieval/ingestion). Never expose to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=case-documents

# ---- Persistence -----------------------------------------------------------
CASE_STORE=sqlite                  # sqlite | supabase
SQLITE_PATH=data/pjn.sqlite3
UPLOAD_DIR=uploads

# ---- Legal corpus / retrieval ---------------------------------------------
# LEGAL_DATA_DIR=../frontend       # holds data/member4_manifest.csv, data/rag_index, pakistan_legal_corpus
RETRIEVAL_BACKEND=auto             # auto | local | supabase
SEMANTIC_SEARCH_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=300
CLAMAV_HOST=                       # set to enable clamd INSTREAM scanning (fails closed when unreachable)
CLAMAV_PORT=3310

# ---- HTTP hardening --------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=12582912
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20
TRUST_PROXY_HEADERS=false          # true only behind a proxy that overwrites X-Forwarded-For
